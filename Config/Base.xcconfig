// Shared build settings. Personal signing settings go in Config/Local.xcconfig
// (not committed), e.g.:
//   DEVELOPMENT_TEAM = ABCDE12345
//   BUNDLE_ID_PREFIX = com.yourname.yapnest
//   KLIPY_API_KEY = your-klipy-key
BUNDLE_ID_PREFIX = fr.yapnest.app
DEVELOPMENT_TEAM =

PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX)
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 12

// The GIF picker is hidden without a key. The real one goes in Local.xcconfig.
KLIPY_API_KEY =

#include? "Local.xcconfig"
